[user]
	name = {{ .name }}
	email = {{ .email }}
{{- if not .is_work }}
	signingkey = ~/.ssh/github.pub
{{- end }}

{{- if not .is_work }}

[gpg]
	format = ssh

[commit]
	gpgsign = true

[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
{{- end }}

[core]
	autocrlf = input
	pager = delta --line-numbers

[merge]
	conflictstyle = zdiff3

[log]
	abbrevCommit = true

[branch]
	sort = -committerdate
    autosetupmerge = simple
    autosetuprebase = remote

[rebase]
    autostash = true

[pull]
    rebase = true

[push]
	autoSetupRemote = true

[diff]
	algorithm = histogram
	colorMoved = plain
	renames = true

[blame]
	ignoreRevsFile = .git-blame-ignore-revs

[alias]
     alias = "!git config --get-regexp '^alias\\.' | awk '{ n[NR] = substr($1, 7); v[NR] = substr($0, length($1) + 2); if (length(n[NR]) > w) w = length(n[NR]) } END { for (i = 1; i <= NR; i++) printf \"\\033[33m%-\" w \"s\\033[0m = %s\\n\", n[i], v[i] }'"

    s = status
    c = commit
    cm = commit -m
    ca = commit --amend
    can = commit --amend --no-edit
    cf = commit --fixup
    cfi = "!f() { c=$(git log --oneline --color=always -10 | fzf --ansi --height 40% --reverse --no-sort --preview 'git show -s --format=%B {1}' | cut -d' ' -f1) && [ -n \"$c\" ] && git commit --fixup \"$c\" \"$@\"; }; f"
    ri = rebase -i
    ria = rebase -i --autosquash
    rc = rebase --continue
    st = stash -u
    stm = stash push -u -m
    sl = stash list
    sp = stash pop
    d = diff
    ds = diff --staged
    r = restore
    rs = restore --staged
    bl = branch -l
    swi = "!f() { b=$(git branch --all --format='%(refname:short)' | sed 's#^origin/##' | grep -vx 'origin' | awk '!seen[$0]++' | fzf --height 40% --reverse --select-1 --query=\"$*\" --preview 'git log --oneline --graph --color=always -25 {} -- 2>/dev/null || git log --oneline --graph --color=always -20 origin/{} --') && git switch \"$b\"; }; f"

{{- if .is_work }}
    ctm = log --oneline origin/master..HEAD
{{- end }}

[include]
	path = ~/.config/git/gitconfig-light
	path = ~/.config/git/theme-current
	path = ~/.gitconfig.local
