[user]
	name = {{ .name }}
	email = {{ .email }}
{{- if not .is_work }}
	signingkey = ~/.ssh/github.pub
{{- end }}

{{- if not .is_work }}

[gpg]
	format = ssh

[commit]
	gpgsign = true

[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
{{- end }}

[core]
	autocrlf = input
	pager = delta --line-numbers

[merge]
	conflictstyle = zdiff3

[log]
	abbrevCommit = true

[branch]
	sort = -committerdate
    autosetupmerge = simple
    autosetuprebase = remote

[rebase]
    autostash = true

[pull]
    rebase = true

[push]
	autoSetupRemote = true

[diff]
	algorithm = histogram
	colorMoved = plain
	renames = true

[blame]
	ignoreRevsFile = .git-blame-ignore-revs

[alias]
    s = status
    c = commit
    ca = commit --amend
    can = commit --amend --no-edit
    cf = commit --fixup
    ri = rebase -i
    ria = rebase -i --autosquash
    rc = rebase --continue
    st = stash
    stm = stash push -m
    sl = stash list
    sp = stash pop
    d = diff
    ds = diff --staged
    r = restore
    rs = restore --staged

[include]
	path = ~/.config/git/gitconfig-light
	path = ~/.config/git/theme-current
	path = ~/.gitconfig.local
